rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().isActive == true;
    }

    function sameOrg(orgId) {
      return isPlatformOwner() || (isActive() && userDoc().orgId == orgId);
    }

    function isPlatformOwner() {
      return isActive()
        && userDoc().role == 'platformOwner';
    }

    function isManagerAdmin() {
      return isActive()
        && userDoc().role in ['platformOwner', 'superAdmin', 'managerAdmin'];
    }

    function isSuperAdmin() {
      return isActive()
        && userDoc().role in ['platformOwner', 'superAdmin'];
    }

    function isImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function roomData(orgId, roomId) {
      return firestore.get(
        /databases/(default)/documents/organizations/$(orgId)/chatRooms/$(roomId)
      ).data;
    }

    function roomExists(orgId, roomId) {
      return firestore.exists(
        /databases/(default)/documents/organizations/$(orgId)/chatRooms/$(roomId)
      );
    }

    function hasAssignedLeague(leagueId) {
      return 'leagueIds' in userDoc() && leagueId in userDoc().leagueIds;
    }

    function hasAssignedHub(hubId) {
      return 'hubIds' in userDoc() && hubId in userDoc().hubIds;
    }

    function hasAssignedTeam(teamId) {
      return 'teamIds' in userDoc() && teamId in userDoc().teamIds;
    }

    function hasMultiTeamAudience(room) {
      return room.keys().hasAll(['teamIds', 'hubIds'])
        && room.teamIds is list
        && room.teamIds.size() > 0
        && room.hubIds is list
        && room.hubIds.size() > 0;
    }

    function canReadRoom(orgId, roomId) {
      let room = roomData(orgId, roomId);
      return sameOrg(orgId)
        && roomExists(orgId, roomId)
        && (
          isSuperAdmin()
          || (room.type == 'direct' && request.auth.uid in room.participants)
          || (
            room.type in ['league', 'event']
            && (hasMultiTeamAudience(room)
              ? (
                (
                  'teamIds' in userDoc()
                  && room.teamIds.hasAny(userDoc().teamIds)
                )
                || (
                  'hubIds' in userDoc()
                  && room.hubIds.hasAny(userDoc().hubIds)
                )
              )
              : (
              (
                'teamId' in room
                && room.teamId != null
                && (
                  hasAssignedTeam(room.teamId)
                  || (
                    'hubId' in room
                    && room.hubId != null
                    && hasAssignedHub(room.hubId)
                  )
                )
              )
              || (
                'hubId' in room
                && room.hubId != null
                && (!('teamId' in room) || room.teamId == null)
                && hasAssignedHub(room.hubId)
              )
              || (
                (!('hubId' in room) || room.hubId == null)
                && (
                  !('leagueId' in room)
                  || room.leagueId == null
                  || hasAssignedLeague(room.leagueId)
                )
              ))
            )
          )
        );
    }

    function policyData(orgId, policyId) {
      return firestore.get(
        /databases/(default)/documents/organizations/$(orgId)/policies/$(policyId)
      ).data;
    }

    function policyExists(orgId, policyId) {
      return firestore.exists(
        /databases/(default)/documents/organizations/$(orgId)/policies/$(policyId)
      );
    }

    function canReadPolicy(orgId, policyId) {
      let policy = policyData(orgId, policyId);
      return sameOrg(orgId)
        && policyExists(orgId, policyId)
        && (
          isSuperAdmin()
          || (
            'teamId' in policy
            && policy.teamId != null
            && (
              hasAssignedTeam(policy.teamId)
              || (
                'hubId' in policy
                && policy.hubId != null
                && hasAssignedHub(policy.hubId)
              )
            )
          )
          || (
            'hubId' in policy
            && policy.hubId != null
            && (!('teamId' in policy) || policy.teamId == null)
            && hasAssignedHub(policy.hubId)
          )
          || (
            (!('hubId' in policy) || policy.hubId == null)
            && (!('teamId' in policy) || policy.teamId == null)
          )
        );
    }

    function canManagePolicyFile(orgId, policyId) {
      let policy = policyData(orgId, policyId);
      return sameOrg(orgId)
        && policyExists(orgId, policyId)
        && (
          isSuperAdmin()
          || (
            userDoc().role == 'managerAdmin'
            && policy.uploadedBy == request.auth.uid
            && (
              (
                'teamId' in policy
                && policy.teamId != null
                && (
                  hasAssignedTeam(policy.teamId)
                  || (
                    'hubId' in policy
                    && policy.hubId != null
                    && hasAssignedHub(policy.hubId)
                  )
                )
              )
              || (
                'hubId' in policy
                && policy.hubId != null
                && (!('teamId' in policy) || policy.teamId == null)
                && hasAssignedHub(policy.hubId)
              )
            )
          )
        );
    }

    match /orgs/{orgId}/avatars/{fileName} {
      allow read: if sameOrg(orgId);
      allow write: if sameOrg(orgId)
        && fileName == request.auth.uid + '.jpg'
        && isImageUpload(5 * 1024 * 1024);
    }

    match /orgs/{orgId}/chat/{roomId}/room-images/{userId}/{fileName} {
      allow read: if canReadRoom(orgId, roomId);
      allow write: if canReadRoom(orgId, roomId)
        && request.auth.uid == userId
        && isImageUpload(10 * 1024 * 1024);
    }

    match /orgs/{orgId}/chat/{roomId}/attachments/{userId}/{fileName} {
      allow read: if canReadRoom(orgId, roomId);
      allow write: if canReadRoom(orgId, roomId)
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /orgs/{orgId}/logos/{entityType}/{entityId}/{userId}/{fileName} {
      allow read: if sameOrg(orgId);
      allow write: if sameOrg(orgId)
        && isManagerAdmin()
        && request.auth.uid == userId
        && isImageUpload(10 * 1024 * 1024);
    }

    match /orgs/{orgId}/chat/{roomId}/{fileName=**} {
      allow read: if canReadRoom(orgId, roomId);
      allow write: if canReadRoom(orgId, roomId)
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /organizations/{orgId}/chatRooms/{fileName} {
      allow read: if sameOrg(orgId);
      allow write: if sameOrg(orgId)
        && isManagerAdmin()
        && isImageUpload(10 * 1024 * 1024);
    }

    match /organizations/{orgId}/policies/{policyId}/{fileName} {
      allow read: if canReadPolicy(orgId, policyId);
      allow write: if canManagePolicyFile(orgId, policyId)
        && request.resource != null
        && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if sameOrg(orgId) && isSuperAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
