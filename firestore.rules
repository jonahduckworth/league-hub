rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function invitePath(orgId, inviteId) {
      return /databases/$(database)/documents/organizations/$(orgId)/invitations/$(inviteId);
    }

    function lookupStatusOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function invitationIsUnexpired(data) {
      return 'expiresAt' in data
        && data.expiresAt is timestamp
        && request.time <= data.expiresAt;
    }

    function validOptionalInvitationExpiry(data) {
      return !('expiresAt' in data)
        || (
          data.expiresAt is timestamp
          && request.time < data.expiresAt
          && data.expiresAt <= request.time + duration.value(7, 'd')
        );
    }

    function roomPath(orgId, roomId) {
      return /databases/$(database)/documents/organizations/$(orgId)/chatRooms/$(roomId);
    }

    function messagePath(orgId, roomId, messageId) {
      return /databases/$(database)/documents/organizations/$(orgId)/chatRooms/$(roomId)/messages/$(messageId);
    }

    function isStructureManagedRoom(room) {
      return room.keys().hasAll(['type', 'hubId'])
        && room.type == 'league'
        && room.hubId is string
        && room.hubId.size() > 0;
    }

    function structureManagedRoomFieldsUnchanged() {
      return (
          !isStructureManagedRoom(resource.data)
          && !isStructureManagedRoom(request.resource.data)
        )
        || (
          isStructureManagedRoom(resource.data)
          && isStructureManagedRoom(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'name',
            'type',
            'leagueId',
            'hubId',
            'teamId',
            'hubIds',
            'teamIds',
            'roomIconName',
            'roomImageUrl',
            'managedScope'
          ])
        );
    }

    function isLegacyHubGeneralRoomCreate(orgId, room) {
      let hub = get(hubPath(orgId, room.leagueId, room.hubId)).data;
      return isStructureManagedRoom(room)
        && room.keys().hasOnly([
          'orgId',
          'name',
          'type',
          'leagueId',
          'hubId',
          'teamId',
          'participants',
          'isArchived',
          'createdAt',
          'lastMessage',
          'lastMessageAt',
          'lastMessageBy',
          'roomIconName',
          'roomImageUrl'
        ])
        && room.teamId == null
        && room.participants is list
        && room.participants.size() == 0
        && room.isArchived == false
        && room.lastMessage == null
        && room.lastMessageBy == null
        && room.name == hub.name + ' – General'
        && (
          ('logoUrl' in hub && room.roomImageUrl == hub.logoUrl)
          || (!('logoUrl' in hub) && room.roomImageUrl == null)
        )
        && (
          ('iconName' in hub && room.roomIconName == hub.iconName)
          || (!('iconName' in hub) && room.roomIconName == null)
        );
    }

    function leaguePath(orgId, leagueId) {
      return /databases/$(database)/documents/organizations/$(orgId)/leagues/$(leagueId);
    }

    function hubPath(orgId, leagueId, hubId) {
      return /databases/$(database)/documents/organizations/$(orgId)/leagues/$(leagueId)/hubs/$(hubId);
    }

    function teamPath(orgId, leagueId, hubId, teamId) {
      return /databases/$(database)/documents/organizations/$(orgId)/leagues/$(leagueId)/hubs/$(hubId)/teams/$(teamId);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActive() {
      return hasUserDoc() && currentUser().isActive == true;
    }

    function currentOrgId() {
      return currentUser().orgId;
    }

    function sameOrg(orgId) {
      return isPlatformOwner() || (isActive() && currentOrgId() == orgId);
    }

    function isPlatformOwner() {
      return isActive() && currentUser().role == 'platformOwner';
    }

    function isSuperAdmin() {
      return isActive() && currentUser().role in ['platformOwner', 'superAdmin'];
    }

    function isManagerAdmin() {
      return isActive() && currentUser().role in ['platformOwner', 'superAdmin', 'managerAdmin'];
    }

    function canManageOrg(orgId) {
      return sameOrg(orgId) && isSuperAdmin();
    }

    function canManageContent(orgId) {
      return sameOrg(orgId) && isManagerAdmin();
    }

    function hasAssignedLeague(leagueId) {
      return 'leagueIds' in currentUser()
        && leagueId in currentUser().leagueIds;
    }

    function hasAssignedHub(hubId) {
      return 'hubIds' in currentUser()
        && hubId in currentUser().hubIds;
    }

    function hasAssignedTeam(teamId) {
      return 'teamIds' in currentUser()
        && teamId in currentUser().teamIds;
    }

    function hasMultiTeamAudience(room) {
      return room.keys().hasAll(['teamIds', 'hubIds'])
        && room.teamIds is list
        && room.teamIds.size() > 0
        && room.hubIds is list
        && room.hubIds.size() > 0;
    }

    function validMultiTeamAudience(room) {
      return room.type == 'event'
        && room.roomPurpose == 'event'
        && room.teamIds.size() <= 50
        && room.hubIds.size() <= 50
        && room.teamId is string
        && room.teamId == '__multi_team__'
        && room.hubId is string
        && room.hubId == '__multi_team__';
    }

    function validOptionalMultiTeamAudience(room) {
      return !room.keys().hasAny(['teamIds', 'hubIds'])
        || (
          hasMultiTeamAudience(room)
          && validMultiTeamAudience(room)
        );
    }

    function canManageHub(orgId, hubId) {
      return sameOrg(orgId)
        && (
          isSuperAdmin()
          || (currentUser().role == 'managerAdmin' && hasAssignedHub(hubId))
        );
    }

    function canManageScopedTarget(data) {
      return isSuperAdmin()
        || (
          currentUser().role == 'managerAdmin'
          && (
            (
              'teamId' in data
              && data.teamId != null
              && (
                hasAssignedTeam(data.teamId)
                || (
                  'hubId' in data
                  && data.hubId != null
                  && hasAssignedHub(data.hubId)
                )
              )
            )
            || (
              'teamId' in data
              && data.teamId == null
              && 'hubId' in data
              && data.hubId != null
              && hasAssignedHub(data.hubId)
            )
            || (
              'teamId' in data
              && data.teamId == null
              && 'hubId' in data
              && data.hubId == null
              && 'leagueId' in data
              && data.leagueId != null
              && hasAssignedLeague(data.leagueId)
            )
          )
        );
    }

    function canManageRoomTarget(data) {
      return hasMultiTeamAudience(data)
        ? (
          isSuperAdmin()
          || (
            currentUser().role == 'managerAdmin'
            && (
              (
                'teamIds' in currentUser()
                && data.teamIds.hasOnly(currentUser().teamIds)
              )
              || (
                'hubIds' in currentUser()
                && data.hubIds.hasOnly(currentUser().hubIds)
              )
            )
          )
        )
        : canManageScopedTarget(data);
    }

    function scopedTargetExists(orgId, data) {
      return hasMultiTeamAudience(data)
        ? (
          data.leagueId is string
          && exists(leaguePath(orgId, data.leagueId))
        )
        : (
          !('leagueId' in data)
          || data.leagueId == null
        )
        || (
          data.leagueId is string
          && exists(leaguePath(orgId, data.leagueId))
          && (
            (!('hubId' in data) || data.hubId == null)
            || (
              data.hubId is string
              && exists(hubPath(orgId, data.leagueId, data.hubId))
              && (
                (!('teamId' in data) || data.teamId == null)
                || (
                  data.teamId is string
                  && exists(teamPath(
                    orgId,
                    data.leagueId,
                    data.hubId,
                    data.teamId
                  ))
                )
              )
            )
          )
        );
    }

    function validPolicyTarget(orgId, data) {
      return (
          (!('leagueId' in data) || data.leagueId == null)
          && (!('hubId' in data) || data.hubId == null)
          && (!('teamId' in data) || data.teamId == null)
        )
        || (
          data.leagueId is string
          && data.hubId is string
          && exists(leaguePath(orgId, data.leagueId))
          && exists(hubPath(orgId, data.leagueId, data.hubId))
          && (
            (!('teamId' in data) || data.teamId == null)
            || (
              data.teamId is string
              && exists(teamPath(
                orgId,
                data.leagueId,
                data.hubId,
                data.teamId
              ))
            )
          )
        );
    }

    function canManagePolicyTarget(data) {
      return (
          (!('leagueId' in data) || data.leagueId == null)
          && (!('hubId' in data) || data.hubId == null)
          && (!('teamId' in data) || data.teamId == null)
          && isSuperAdmin()
        )
        || (
          data.leagueId is string
          && data.hubId is string
          && canManageScopedTarget(data)
        );
    }

    function validAnnouncementTarget(data) {
      return data.keys().hasAll(['scope', 'leagueId', 'hubId', 'teamId'])
        && data.scope in ['league', 'hub', 'team']
        && data.leagueId is string
        && data.leagueId.size() > 0
        && (
          (data.scope == 'league' && data.hubId == null && data.teamId == null)
          || (
            data.scope == 'hub'
            && data.hubId is string
            && data.hubId.size() > 0
            && data.teamId == null
          )
          || (
            data.scope == 'team'
            && data.hubId is string
            && data.hubId.size() > 0
            && data.teamId is string
            && data.teamId.size() > 0
          )
        );
    }

    function announcementTargetExists(orgId, data) {
      return exists(leaguePath(orgId, data.leagueId))
        && (
          data.scope == 'league'
          || (
            exists(hubPath(orgId, data.leagueId, data.hubId))
            && (
              data.scope == 'hub'
              || exists(teamPath(orgId, data.leagueId, data.hubId, data.teamId))
            )
          )
        );
    }

    function canManageAnnouncementTarget(data) {
      return isSuperAdmin()
        || (
          currentUser().role == 'managerAdmin'
          && (
            (
              data.scope == 'league'
              && 'leagueIds' in currentUser()
              && data.leagueId in currentUser().leagueIds
            )
            || (
              data.scope == 'hub'
              && 'hubIds' in currentUser()
              && data.hubId in currentUser().hubIds
            )
            || (
              data.scope == 'team'
              && (
                (
                  'teamIds' in currentUser()
                  && data.teamId in currentUser().teamIds
                )
                || (
                  'hubIds' in currentUser()
                  && data.hubId in currentUser().hubIds
                )
              )
            )
          )
        );
    }

    function validPolicyCategory(data) {
      return data.category in ['Policy', 'Waiver', 'Protocol', 'Code of Conduct', 'Other'];
    }

    function canBootstrapOrg(orgId) {
      return signedIn()
        && exists(orgPath(orgId))
        && get(orgPath(orgId)).data.ownerId == request.auth.uid;
    }

    function canReadOrg(orgId) {
      return isPlatformOwner() || sameOrg(orgId) || canBootstrapOrg(orgId);
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidOwnerUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'platformOwner'
        && request.resource.data.isActive == true
        && request.resource.data.orgId is string
        && canBootstrapOrg(request.resource.data.orgId);
    }

    function invitationMatchesNewUser(invite) {
      return invite.status == 'pending'
        && invitationIsUnexpired(invite)
        && invite.email == request.auth.token.email
        && invite.role == request.resource.data.role
        && invite.leagueIds == request.resource.data.leagueIds
        && invite.hubIds == request.resource.data.hubIds
        && invite.teamIds == request.resource.data.teamIds;
    }

    function canCreateInvitationForRole(orgId, role) {
      return sameOrg(orgId)
        && (
          (
            currentUser().role == 'platformOwner'
            && role in ['superAdmin', 'managerAdmin', 'staff']
          )
          || (
            currentUser().role == 'superAdmin'
            && role in ['managerAdmin', 'staff']
          )
          || (currentUser().role == 'managerAdmin' && role == 'staff')
        );
    }

    function validManagerInvitationScope(data) {
      return currentUser().role != 'managerAdmin'
        || (
          data.role == 'staff'
          && data.leagueIds is list
          && data.leagueIds.hasOnly(currentUser().leagueIds)
          && data.hubIds is list
          && data.hubIds.size() > 0
          && data.hubIds.hasOnly(currentUser().hubIds)
          && data.teamIds is list
          && data.teamIds.hasOnly(currentUser().teamIds)
        );
    }

    function canAcceptInvitedRole(invite) {
      return invite.role in ['managerAdmin', 'staff']
        || (
          invite.role == 'superAdmin'
          && exists(userPath(invite.invitedBy))
          && get(userPath(invite.invitedBy)).data.role == 'platformOwner'
        );
    }

    function isValidInvitedUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.orgId is string
        && request.resource.data.acceptedInvitationId is string
        && request.resource.data.isActive == true
        && exists(invitePath(
          request.resource.data.orgId,
          request.resource.data.acceptedInvitationId
        ))
        && canAcceptInvitedRole(get(invitePath(
          request.resource.data.orgId,
          request.resource.data.acceptedInvitationId
        )).data)
        && invitationMatchesNewUser(get(invitePath(
          request.resource.data.orgId,
          request.resource.data.acceptedInvitationId
        )).data);
    }

    function selfUpdateFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'email',
        'title',
        'phone',
        'address',
        'avatarUrl',
        'fcmTokens',
        'blockedUserIds',
        'hasAcceptedCommunityGuidelines'
      ]);
    }

    function validSelfSafetySettings() {
      return (
          !('blockedUserIds' in request.resource.data)
          || (
            request.resource.data.blockedUserIds is list
            && request.resource.data.blockedUserIds.size() <= 1000
            && !(request.auth.uid in request.resource.data.blockedUserIds)
          )
        )
        && (
          !('hasAcceptedCommunityGuidelines' in request.resource.data)
          || (
            request.resource.data.hasAcceptedCommunityGuidelines is bool
            && (
              (
                'hasAcceptedCommunityGuidelines' in resource.data
                && resource.data.hasAcceptedCommunityGuidelines != true
              )
              || request.resource.data.hasAcceptedCommunityGuidelines == true
            )
          )
        );
    }

    function canReadUser(userData) {
      return isActive()
        && (isPlatformOwner() || userData.orgId == currentOrgId());
    }

    function canAdminUpdateUser(userData) {
      return isActive()
        && request.resource.data.id == userData.id
        && request.resource.data.orgId == userData.orgId
        && request.resource.data.email == userData.email
        && request.resource.data.hubIds is list
        && request.resource.data.leagueIds is list
        && request.resource.data.teamIds is list
        && request.resource.data.diff(userData).affectedKeys().hasOnly([
          'role',
          'hubIds',
          'leagueIds',
          'teamIds',
          'title',
          'phone',
          'address',
          'isActive'
        ])
        && (
          (
            isPlatformOwner()
            && userData.role != 'platformOwner'
            && request.resource.data.role != 'platformOwner'
          )
          || (
            userData.orgId == currentOrgId()
            && (
              (
                currentUser().role == 'superAdmin'
                && (
                  (
                    userData.role in ['managerAdmin', 'staff']
                    && request.resource.data.role in ['managerAdmin', 'staff']
                  )
                  || (
                    userData.role == 'superAdmin'
                    && request.resource.data.role == 'superAdmin'
                    && request.resource.data.diff(userData).affectedKeys().hasOnly([
                      'hubIds',
                      'leagueIds',
                      'teamIds'
                    ])
                  )
                )
              )
              || (
                currentUser().role == 'managerAdmin'
                && userData.role == 'staff'
                && request.resource.data.role == 'staff'
                && userData.hubIds is list
                && userData.hubIds.size() > 0
                && userData.hubIds.hasOnly(currentUser().hubIds)
                && userData.teamIds is list
                && userData.teamIds.hasOnly(currentUser().teamIds)
                && request.resource.data.hubIds is list
                && request.resource.data.hubIds.size() > 0
                && request.resource.data.hubIds.hasOnly(currentUser().hubIds)
                && request.resource.data.leagueIds is list
                && request.resource.data.leagueIds.hasOnly(currentUser().leagueIds)
                && request.resource.data.teamIds is list
                && request.resource.data.teamIds.hasOnly(currentUser().teamIds)
              )
            )
          )
        );
    }

    function validOrganizationUpdate(orgId) {
      return request.resource.data.id == orgId
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'logoUrl',
          'primaryColor',
          'secondaryColor',
          'accentColor'
        ]);
    }

    function validTeamCreate(orgId, leagueId, hubId) {
      return request.resource.data.orgId == orgId
        && request.resource.data.leagueId == leagueId
        && request.resource.data.hubId == hubId
        && request.resource.data.memberIds is list
        && (isSuperAdmin() || request.resource.data.memberIds.size() == 0);
    }

    function validTeamUpdate(orgId, leagueId, hubId, teamId) {
      return request.resource.data.id == resource.data.id
        && request.resource.data.orgId == orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.leagueId == leagueId
        && request.resource.data.leagueId == resource.data.leagueId
        && request.resource.data.hubId == hubId
        && request.resource.data.hubId == resource.data.hubId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds'])
          || isSuperAdmin()
          || (
            currentUser().role == 'managerAdmin'
            && hasAssignedHub(hubId)
            && hasAssignedTeam(teamId)
          )
        );
    }

    function validAnnouncementUpdate(orgId) {
      return request.resource.data.orgId == orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorRole == resource.data.authorRole
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'body',
          'scope',
          'leagueId',
          'hubId',
          'teamId',
          'attachments',
          'isPinned',
          'updatedAt'
        ])
        && (isSuperAdmin() || request.resource.data.isPinned == resource.data.isPinned);
    }

    function validPolicyUpdate(orgId) {
      return request.resource.data.orgId == orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'fileUrl',
          'fileType',
          'fileSize',
          'category',
          'leagueId',
          'hubId',
          'teamId',
          'versions',
          'uploadStatus',
          'updatedAt'
        ]);
    }

    function validDirectRoomCreate(orgId, data) {
      return sameOrg(orgId)
        && data.orgId == orgId
        && data.type == 'direct'
        && data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && data.participants[0] != data.participants[1]
        && exists(userPath(data.participants[0]))
        && exists(userPath(data.participants[1]))
        && get(userPath(data.participants[0])).data.isActive == true
        && get(userPath(data.participants[1])).data.isActive == true
        && get(userPath(data.participants[0])).data.orgId == orgId
        && get(userPath(data.participants[1])).data.orgId == orgId;
    }

    function validOptionalRoomPurpose(data) {
      return !('roomPurpose' in data)
        || (
          data.type == 'event'
          && data.roomPurpose in ['group', 'event']
        );
    }

    function roomIsReadable(room) {
      return sameOrg(room.orgId)
        && (
          isSuperAdmin()
          || (room.type == 'direct' && request.auth.uid in room.participants)
          || (
            room.type in ['league', 'event']
            && (hasMultiTeamAudience(room)
              ? (
                (
                  'teamIds' in currentUser()
                  && room.teamIds.hasAny(currentUser().teamIds)
                )
                || (
                  currentUser().role == 'managerAdmin'
                  &&
                  'hubIds' in currentUser()
                  && room.hubIds.hasAny(currentUser().hubIds)
                )
              )
              : (
              (
                'teamId' in room
                && room.teamId != null
                && (
                  hasAssignedTeam(room.teamId)
                  || (
                    'hubId' in room
                    && room.hubId != null
                    && hasAssignedHub(room.hubId)
                  )
                )
              )
              ||
              (
                'hubId' in room
                && room.hubId != null
                && (!('teamId' in room) || room.teamId == null)
                && hasAssignedHub(room.hubId)
              )
              ||
              (
                (!('hubId' in room) || room.hubId == null)
                && (!('teamId' in room) || room.teamId == null)
                && (
                  !('leagueId' in room)
                  || room.leagueId == null
                  || hasAssignedLeague(room.leagueId)
                )
              ))
            )
          )
        );
    }

    function canReadRoom(orgId, roomId) {
      let room = get(roomPath(orgId, roomId)).data;
      return exists(roomPath(orgId, roomId))
        && (
          room.type == 'direct'
            ? sameOrg(room.orgId) && request.auth.uid in room.participants
            : roomIsReadable(room)
        );
    }

    function directRecipientAllowsSender(room) {
      return room.type != 'direct'
        || (
          room.participants.size() == 2
          && (
            (
              room.participants[0] == request.auth.uid
              && exists(userPath(room.participants[1]))
              && (
                !('blockedUserIds' in get(userPath(room.participants[1])).data)
                || !(request.auth.uid in get(userPath(room.participants[1])).data.blockedUserIds)
              )
            )
            || (
              room.participants[1] == request.auth.uid
              && exists(userPath(room.participants[0]))
              && (
                !('blockedUserIds' in get(userPath(room.participants[0])).data)
                || !(request.auth.uid in get(userPath(room.participants[0])).data.blockedUserIds)
              )
            )
          )
        );
    }

    function messageCreateIsOwnMessage(orgId, roomId) {
      return request.resource.data.keys().hasAll([
          'chatRoomId',
          'senderId',
          'senderName',
          'text',
          'previewText',
          'createdAt',
          'readBy'
        ])
        && request.resource.data.keys().hasOnly([
          'chatRoomId',
          'senderId',
          'senderName',
          'text',
          'previewText',
          'mediaUrl',
          'mediaType',
          'createdAt',
          'readBy'
        ])
        && request.resource.data.chatRoomId == roomId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName == currentUser().displayName
        && currentUser().hasAcceptedCommunityGuidelines == true
        && (
          request.resource.data.text == null
          || (
            request.resource.data.text is string
            && request.resource.data.text.size() <= 4000
          )
        )
        && request.resource.data.previewText is string
        && request.resource.data.previewText.size() > 0
        && request.resource.data.previewText.size() <= 4000
        && (
          request.resource.data.previewText == request.resource.data.text
          || (
            request.resource.data.text == null
            && request.resource.data.mediaUrl is string
            && request.resource.data.mediaUrl.size() <= 2048
            && request.resource.data.mediaType is string
            && request.resource.data.mediaType.size() <= 120
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() == 1
        && request.resource.data.readBy[0] == request.auth.uid
        && directRecipientAllowsSender(get(roomPath(orgId, roomId)).data);
    }

    function messageReadReceiptOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }

    function ownMessageContentUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'text',
        'mediaUrl',
        'editedAt',
        'deleted',
        'deletedAt'
      ]);
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || canReadUser(resource.data);
      allow list: if canReadUser(resource.data);
      allow create: if isValidOwnerUserCreate(userId) || isValidInvitedUserCreate(userId);
      allow update: if (
        isSelf(userId)
        && resource.data.orgId == currentOrgId()
        && selfUpdateFieldsOnly()
        && validSelfSafetySettings()
      ) || canAdminUpdateUser(resource.data);
      allow delete: if false;
    }

    match /invitationLookups/{token} {
      allow get: if resource.data.status == 'pending'
        && resource.data.token == token
        && invitationIsUnexpired(resource.data);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.token == token
        && request.resource.data.status == 'pending'
        && request.resource.data.orgId is string
        && request.resource.data.invitationId is string
        && request.resource.data.email is string
        && validOptionalInvitationExpiry(request.resource.data)
        && canManageContent(request.resource.data.orgId);
      allow update: if (
        canManageContent(resource.data.orgId)
      ) || (
        signedIn()
        && resource.data.status == 'pending'
        && invitationIsUnexpired(resource.data)
        && resource.data.email == request.auth.token.email
        && lookupStatusOnly()
        && request.resource.data.status == 'accepted'
      );
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow get, list: if canReadOrg(orgId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == orgId;
      allow update: if canManageOrg(orgId) && validOrganizationUpdate(orgId);
      allow delete: if isPlatformOwner();

      match /leagues/{leagueId} {
        allow get, list: if canReadOrg(orgId);
        allow create: if sameOrg(orgId) && isPlatformOwner();
        allow update: if canManageOrg(orgId);
        allow delete: if canManageOrg(orgId);

        match /hubs/{hubId} {
          allow get, list: if canReadOrg(orgId);
          allow create: if canManageOrg(orgId);
          allow update: if canManageHub(orgId, hubId);
          allow delete: if canManageOrg(orgId);

          match /teams/{teamId} {
            allow get, list: if canReadOrg(orgId);
            allow create: if canManageHub(orgId, hubId)
              && validTeamCreate(orgId, leagueId, hubId);
            allow update: if canManageHub(orgId, hubId)
              && validTeamUpdate(orgId, leagueId, hubId, teamId);
            allow delete: if canManageHub(orgId, hubId);
          }
        }
      }

      match /chatRooms/{roomId} {
        allow get, list: if roomIsReadable(resource.data);
        allow create: if validOptionalRoomPurpose(request.resource.data)
          && validOptionalMultiTeamAudience(request.resource.data)
          && (
            validDirectRoomCreate(orgId, request.resource.data)
            || (
              canManageContent(orgId)
              && request.resource.data.orgId == orgId
              && request.resource.data.type in ['league', 'event']
              && !hasMultiTeamAudience(request.resource.data)
              && (
                !isStructureManagedRoom(request.resource.data)
                || isLegacyHubGeneralRoomCreate(orgId, request.resource.data)
              )
              && canManageRoomTarget(request.resource.data)
              && scopedTargetExists(orgId, request.resource.data)
            )
          );
        allow update: if canManageContent(orgId)
            && resource.data.type in ['league', 'event']
            && request.resource.data.type in ['league', 'event']
            && validOptionalRoomPurpose(request.resource.data)
            && validOptionalMultiTeamAudience(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'roomPurpose',
              'hubIds',
              'teamIds'
            ])
            && (
              !hasMultiTeamAudience(resource.data)
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'leagueId',
                'hubId',
                'teamId'
              ])
            )
            && canManageRoomTarget(resource.data)
            && canManageRoomTarget(request.resource.data)
            && scopedTargetExists(orgId, request.resource.data)
            && structureManagedRoomFieldsUnchanged()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lastMessage',
              'lastMessageAt',
              'lastMessageBy',
              'lastMessageSenderId',
              'lastMessageId'
            ]);
        allow delete: if false;

        match /messages/{messageId} {
          allow get, list: if canReadRoom(orgId, roomId);
          allow create: if canReadRoom(orgId, roomId)
            && messageCreateIsOwnMessage(orgId, roomId);
          allow update: if canReadRoom(orgId, roomId)
            && (
              messageReadReceiptOnly()
              || (
                resource.data.senderId == request.auth.uid
                && ownMessageContentUpdateOnly()
              )
              || canManageOrg(orgId)
            );
          allow delete: if canReadRoom(orgId, roomId)
            && canManageOrg(orgId);
        }

        match /typing/{userId} {
          allow get, list: if canReadRoom(orgId, roomId);
          allow create, update, delete: if isSelf(userId)
            && canReadRoom(orgId, roomId);
        }
      }


      match /messageReports/{reportId} {
        allow create: if sameOrg(orgId)
          && request.resource.data.orgId == orgId
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reportedUserId != request.auth.uid
          && request.resource.data.roomId is string
          && request.resource.data.messageId is string
          && canReadRoom(orgId, request.resource.data.roomId)
          && exists(messagePath(
            orgId,
            request.resource.data.roomId,
            request.resource.data.messageId
          ))
          && get(messagePath(
            orgId,
            request.resource.data.roomId,
            request.resource.data.messageId
          )).data.senderId == request.resource.data.reportedUserId
          && request.resource.data.reason in [
            'Harassment or bullying',
            'Hateful or abusive content',
            'Sexual or inappropriate content',
            'Spam or misleading content',
            'Safety concern',
            'Other'
          ]
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && (
            !('details' in request.resource.data)
            || (
              request.resource.data.details is string
              && request.resource.data.details.size() <= 500
            )
          )
          && request.resource.data.diff({}).affectedKeys().hasOnly([
            'orgId',
            'roomId',
            'messageId',
            'reporterId',
            'reportedUserId',
            'reason',
            'details',
            'status',
            'createdAt'
          ]);
        allow get: if sameOrg(orgId)
          && (resource.data.reporterId == request.auth.uid || isSuperAdmin());
        allow list, update: if canManageOrg(orgId);
        allow delete: if false;
      }

      match /policies/{policyId} {
        allow get, list: if sameOrg(orgId);
        allow create: if canManageContent(orgId)
          && request.resource.data.orgId == orgId
          && request.resource.data.uploadedBy == request.auth.uid
          && validPolicyCategory(request.resource.data)
          && canManagePolicyTarget(request.resource.data)
          && validPolicyTarget(orgId, request.resource.data);
        allow update: if canManageContent(orgId)
          && validPolicyUpdate(orgId)
          && canManagePolicyTarget(resource.data)
          && canManagePolicyTarget(request.resource.data)
          && validPolicyTarget(orgId, request.resource.data)
          && (canManageOrg(orgId) || resource.data.uploadedBy == request.auth.uid)
          && (
            request.resource.data.category == resource.data.category
            || validPolicyCategory(request.resource.data)
          );
        allow delete: if canManageOrg(orgId);
      }

      match /announcements/{announcementId} {
        allow get, list: if sameOrg(orgId);
        allow create: if canManageContent(orgId)
          && request.resource.data.authorId == request.auth.uid
          && (isSuperAdmin() || request.resource.data.isPinned == false)
          && validAnnouncementTarget(request.resource.data)
          && announcementTargetExists(orgId, request.resource.data)
          && canManageAnnouncementTarget(request.resource.data);
        allow update: if canManageContent(orgId)
          && validAnnouncementUpdate(orgId)
          && validAnnouncementTarget(request.resource.data)
          && announcementTargetExists(orgId, request.resource.data)
          && canManageAnnouncementTarget(request.resource.data)
          && (
            resource.data.authorId == request.auth.uid
            || canManageOrg(orgId)
          );
        allow delete: if canManageOrg(orgId);
      }

      match /scheduleEvents/{eventId} {
        allow get, list: if sameOrg(orgId);
        allow create, update, delete: if false;
      }

      match /scheduleSync/{documentId} {
        allow get, list: if sameOrg(orgId);
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow get: if canManageContent(orgId)
          || (
            resource.data.status == 'pending'
            && resource.data.token is string
            && invitationIsUnexpired(resource.data)
          );
        allow list: if canManageContent(orgId);
        allow create: if canManageContent(orgId)
          && request.resource.data.invitedBy == request.auth.uid
          && canCreateInvitationForRole(orgId, request.resource.data.role)
          && validOptionalInvitationExpiry(request.resource.data)
          && validManagerInvitationScope(request.resource.data);
        allow update: if (
            canManageContent(orgId)
            && canCreateInvitationForRole(orgId, resource.data.role)
            && validManagerInvitationScope(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pending', 'expired']
          )
          || (
            signedIn()
            && resource.data.status == 'pending'
            && invitationIsUnexpired(resource.data)
            && resource.data.email == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'accepted'
          );
        allow delete: if canManageOrg(orgId);
      }

      match /auditLogs/{auditLogId} {
        allow get, list: if canManageOrg(orgId);
        allow create, update, delete: if false;
      }

      match /notificationEvents/{notificationEventId} {
        allow get, list: if canManageOrg(orgId);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
